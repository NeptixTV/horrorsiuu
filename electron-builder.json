{
  "appId": "com.goofystudio.daw",
  "productName": "Goofy Studio",
  "copyright": "Goofy Studio",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!electron/afterPack.cjs",
    "package.json"
  ],
  "asar": true,
  "npmRebuild": false,
  "afterPack": "electron/afterPack.cjs",
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false
  },
  "portable": {
    "artifactName": "GoofyStudio-${version}-portable.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Goofy Studio",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "artifactName": "GoofyStudio-${version}-Setup.exe",
    "perMachine": false,
    "allowElevation": true
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "build/icon.png",
    "category": "AudioVideo"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.music"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false
  },
  "extraResources": [
    {
      "from": "dist/THIRD_PARTY_NOTICES.txt",
      "to": "THIRD_PARTY_NOTICES.txt"
    }
  ]
}
